<Window x:Class="FanAtlas.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FanAtlas" Title="Crazy_Batto FanAtlas · Lüfter &amp; Stream" Width="1440" Height="950" MinWidth="1180" MinHeight="800" WindowStartupLocation="CenterScreen">
 <Grid Margin="28,20,28,14" Background="#D90B1320" TextElement.Foreground="{StaticResource Ink}" TextElement.FontSize="13">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="38" Foreground="#2EE6FF" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="CRAZY_BATTO · FAN ATLAS" FontSize="21" FontWeight="Bold"/><TextBlock Text="Lüfter · Temperaturen · Stream Deck · OBS" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#14392F" CornerRadius="15" Padding="14,7" Margin="0,0,16,0"><TextBlock Text="●  Nur mitlesen" Foreground="{StaticResource Accent}"/></Border><Button Content="iCUE-Profil öffnen" Click="ImportProfile_Click" Margin="0"/></StackPanel>
  </Grid>
  <TabControl x:Name="Pages" Grid.Row="1">
   <TabItem Header="Übersicht">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Deine Kühlung. Im Blick." Style="{StaticResource Heading}"/>
     <TextBlock Text="Aktuelle Messwerte aus freigegebenen Quellen. Die Lüftersteuerung bleibt bei deinen vorhandenen Programmen." Style="{StaticResource Caption}" Margin="0,0,0,22"/>
     <UniformGrid Columns="4" Margin="0,0,0,20">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="GPU-TEMPERATUR" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="GpuMetric" Text="—" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="GpuHint" Text="Quelle wird geprüft" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="AKTUELLE MESSWERTE" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="SensorMetric" Text="0" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Temperaturen &amp; Lüfterwerte" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROFIL-ZUORDNUNGEN" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="FanMetric" Text="0" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Gespeichert, nicht live erkannt" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EIGENE KURVEN" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="CurveMetric" Text="0" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Lokal gespeicherte Entwürfe" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
     </UniformGrid>
     <Border Background="#192D3C" CornerRadius="9" Padding="16,11" Margin="0,0,0,19"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceBanner" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="Für CPU, Mainboard und Corsair bitte eine laufende Sensor-CSV verbinden."/><Button Grid.Column="1" Content="Sensorquellen" Click="Sources_Click" Margin="15,0,0,0" Padding="13,6"/></Grid></Border>
     <Grid Margin="0,0,0,10"><TextBlock Text="Temperaturen &amp; Lüfterwerte" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Alle 2 Sekunden · Zeile für Verlauf auswählen" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="11"/></Grid>
     <DataGrid x:Name="SensorGrid" Height="230" IsReadOnly="True" SelectionChanged="SensorGrid_SelectionChanged"><DataGrid.Columns>
      <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Aktuell" Binding="{Binding ValueText}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/><DataGridTextColumn Header="Letzter Wert" Binding="{Binding LastValue}" Width="105"/><DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="1.5*"/><DataGridTextColumn Header="Stand" Binding="{Binding LastUpdate}" Width="75"/>
     </DataGrid.Columns></DataGrid>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,14"><StackPanel><TextBlock x:Name="HistoryTitle" Text="Messwertverlauf · letzte 10 Minuten" FontSize="15" FontWeight="SemiBold"/><local:HistoryChart x:Name="History" Height="145" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Lüfter &amp; Profile">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="Jeder Kanal. Seine Kurve." Style="{StaticResource Heading}"/><TextBlock x:Name="ProfileCaption" Style="{StaticResource Caption}" Text="Öffne ein exportiertes iCUE-Profil, um seine gespeicherten Zuordnungen zu sehen."/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="8"><ListBox x:Name="FanList" SelectionChanged="FanList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock x:Name="FanTitle" Text="Kanal auswählen" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="FanDetails" Style="{StaticResource Caption}" Margin="0,8,0,15"/>
       <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock x:Name="FanCurveTitle" Text="Gespeicherte Kurve" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FanCurveSensor" Style="{StaticResource Caption}" Margin="0,6,0,15"/><local:CurveChart x:Name="FanChart" Height="270"/><Button Content="Im Kurveneditor öffnen" Click="EditFan_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Messwert zu diesem Kanal" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Ordne einen eingelesenen Lüfterwert manuell zu. Profil-IDs und CSV-Namen lassen sich nicht sicher automatisch verbinden." Style="{StaticResource Caption}" Margin="0,7,0,12"/><ComboBox x:Name="FanRpmCombo" SelectionChanged="FanRpmCombo_SelectionChanged"/><TextBlock x:Name="FanLiveValue" Text="Kein Messwert zugeordnet" FontSize="21" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/></StackPanel></Border>
       <TextBlock Text="Die Kurve stammt aus einer Datei. Welches Profil gerade in iCUE aktiv ist und ob ein gespeicherter Kanal angeschlossen ist, lässt sich daraus nicht feststellen." Style="{StaticResource Caption}" FontSize="12" Margin="0,17,0,0"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Kurveneditor">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Deine Kurve. Dein Entwurf." Style="{StaticResource Heading}"/><TextBlock Text="Punkte ziehen oder Werte eingeben. Änderungen bleiben zunächst Entwürfe." Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Importieren" Click="ImportCurve_Click"/><Button Content="+ Neue Kurve" Click="NewCurve_Click"/><Button Content="Speichern" Style="{StaticResource Primary}" Click="SaveCurve_Click" Margin="0"/></StackPanel></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="8"><ListBox x:Name="CurveList" SelectionChanged="CurveList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="CurveNameInput" TextChanged="Draft_TextChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Temperaturbezug (z. B. CPU / Kühlmittel)" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="CurveSensorInput" TextChanged="Draft_TextChanged"/></StackPanel></Grid>
       <TextBlock x:Name="DraftInfo" Text="Eine Kurve auswählen oder neu erstellen." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
       <Border Style="{StaticResource Card}" Padding="14"><local:CurveChart x:Name="EditorChart" Editable="True" Height="245"/></Border>
       <Grid Margin="0,14,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Temperaturvorschau · berechneter Stellwert" Style="{StaticResource Caption}"/><Slider x:Name="PreviewSlider" Minimum="0" Maximum="100" Value="55" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewSlider_ValueChanged" Margin="0,9,0,0"/><TextBlock x:Name="PreviewValue" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Vergleich (gestrichelt)" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="CompareCombo" DisplayMemberPath="Display" SelectionChanged="CompareCombo_SelectionChanged"/></StackPanel>
       </Grid>
       <DataGrid x:Name="PointsGrid" Height="192" CellEditEnding="PointsGrid_CellEditEnding" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Temperatur (°C)" Binding="{Binding Temperature, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="*"/><DataGridTextColumn Header="Lüfterleistung (%)" Binding="{Binding Duty, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="*"/></DataGrid.Columns></DataGrid>
       <WrapPanel Margin="0,11,0,13"><Button Content="+ Punkt" Click="AddPoint_Click"/><Button Content="Punkt entfernen" Click="RemovePoint_Click"/><Button Content="Kurve löschen" Click="DeleteCurve_Click"/></WrapPanel>
       <TextBlock x:Name="ValidationText" Foreground="#F1C078" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <WrapPanel><Button Content="Eigene Kurve speichern" Style="{StaticResource Primary}" Click="SaveCurve_Click"/><Button Content="JSON / CSV exportieren" Click="ExportCurve_Click"/><Button Content="Wertetabelle kopieren" Click="CopyCurve_Click"/></WrapPanel>
       <Border Background="#192D3C" CornerRadius="9" Padding="14" Margin="0,16,0,5"><TextBlock Text="In iCUE anwenden: Gerät → Kühlung → eigene Temperaturkurve. Werte und passenden Temperatursensor dort übernehmen und den gewünschten Lüftern zuweisen. JSON/CSV sind FanAtlas-Dateien, keine direkt importierbaren iCUE-Profile." Style="{StaticResource Caption}" FontSize="12"/></Border>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Sensorquellen">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Verbinden, ohne dazwischenzufunken." Style="{StaticResource Heading}"/>
     <TextBlock Text="FanAtlas öffnet keine Corsair-USB-Verbindung und schreibt weder Lüfterwerte noch Profile in andere Programme." Style="{StaticResource Caption}" Margin="0,0,0,22"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01   iCUE / HWiNFO · CSV" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. In iCUE: Einstellungen → Sensorprotokollierung.&#10;2. Temperaturen und Lüfterdrehzahlen auswählen.&#10;3. Intervall auf 2 Sekunden setzen und Protokollierung starten.&#10;4. Die erzeugte CSV unten auswählen." Style="{StaticResource Caption}" Margin="0,16,0,16"/><WrapPanel><Button Content="CSV verbinden" Style="{StaticResource Primary}" Click="AddCsv_Click"/><Button Content="iCUE-Logs suchen" Click="FindLogs_Click"/><Button Content="Quelle entfernen" Click="RemoveCsv_Click"/></WrapPanel><ListBox x:Name="CsvList" Height="125" Margin="0,16,0,0"/><TextBlock x:Name="CsvStatus" Style="{StaticResource Caption}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="02   NVIDIA · Treiber" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="GPU-Temperatur und einzelne Lüfterwerte, soweit der Treiber sie bereitstellt. Lüfterwerte in % sind keine gemessenen U/min." Style="{StaticResource Caption}" Margin="0,16,0,8"/><CheckBox x:Name="NvidiaToggle" Content="NVIDIA-Werte mitlesen" Click="NvidiaToggle_Click"/><TextBlock x:Name="NvidiaStatus" Style="{StaticResource Caption}" Margin="0,12,0,20"/><TextBlock Text="CPU &amp; Mainboard" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Werden über eine angeschlossene CSV angezeigt, soweit iCUE oder dein vorhandener Monitor sie protokolliert. Für Sensoren, die dort fehlen, gibt es hier keine automatische Hardware-Abfrage." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aktualität &amp; lokale Dateien" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Alte Werte werden als veraltet markiert. Eine CSV zählt erst nach einer neu beobachteten Zeile als aktuell. Nach einem neuen Protokollstart die neue Datei auswählen. Verlauf bleibt nur für diese Sitzung im Speicher." Style="{StaticResource Caption}" Margin="0,12,20,10"/><TextBlock x:Name="StorageInfo" Style="{StaticResource Caption}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Veraltet nach (Sekunden)" Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="StaleCombo" SelectionChanged="StaleCombo_SelectionChanged"/><Button Content="Datenordner öffnen" Click="OpenData_Click" Margin="0,18,0,0"/></StackPanel></Grid></Border>
     <TextBlock Text="Alle Sensorquellen sind optional. Fehlende Unterstützung wird angezeigt; es werden keine Beispielmesswerte erzeugt. Neue Kurven sind Entwürfe und müssen in deinem Steuerprogramm geprüft und aktiviert werden." Style="{StaticResource Caption}" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Lüfterbühne &amp; Stream"><local:StageEditor x:Name="Stage"/></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,17,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Bereit." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="FanAtlas 0.2 · Crazy_Batto" Foreground="{StaticResource Muted}" FontSize="11" Margin="14,0,0,0"/></Grid></Border>
 </Grid>
</Window>

